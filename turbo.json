{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**"
            ],
            "env": [
                "MASTER_KEY_HEX"
            ]
        },
        "lint": {},
        "typecheck": {}
    }
}